{
  "name": "Markd",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "version": "0.1.9",
  "description": "A fast, local-first Markdown notes app",
  "author": "Ethan Huo <huodong.work@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "pnpm run typecheck && vite build",
    "package:dir": "pnpm run build && rm -rf release/electron && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir --publish never",
    "package:artifact": "pnpm run build && rm -rf release/electron && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "package:verify": "node scripts/verify-electron-package.mjs",
    "test:packaged": "node scripts/run-packaged-smoke.mjs",
    "package:test": "pnpm run package:artifact && pnpm run package:verify && pnpm run test:packaged",
    "icons:generate": "sigil etch --output src/icons/icons.tsrx --jsx octane",
    "typecheck": "tsrx-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:sync": "node scripts/sync-version.js",
    "pretauri:build": "pnpm run version:sync",
    "test": "vitest run test tests",
    "test:browser": "pnpm run build && playwright test",
    "test:electron": "pnpm run build && playwright test --config playwright.electron.config.ts",
    "icon:generate": "bash scripts/generate-icns.sh"
  },
  "dependencies": {
    "@celados/fff-node": "0.10.2-nightly.0e97c3b",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@octanejs/base-ui": "^0.1.20",
    "@octanejs/cmdk": "^0.1.5",
    "@octanejs/dnd-kit": "^0.1.17",
    "@octanejs/motion": "^0.1.21",
    "@octanejs/sonner": "^0.1.17",
    "@octanejs/tanstack-query": "^0.1.21",
    "@octanejs/tauri": "^0.0.5",
    "@octanejs/tiptap": "^0.0.16",
    "@octanejs/vite-plugin": "^0.1.22",
    "@octanejs/zustand": "^0.1.21",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-blockquote": "3.28.0",
    "@tiptap/extension-bold": "3.28.0",
    "@tiptap/extension-bullet-list": "3.28.0",
    "@tiptap/extension-code": "3.28.0",
    "@tiptap/extension-code-block": "3.28.0",
    "@tiptap/extension-document": "3.28.0",
    "@tiptap/extension-dropcursor": "3.28.0",
    "@tiptap/extension-gapcursor": "3.28.0",
    "@tiptap/extension-hard-break": "3.28.0",
    "@tiptap/extension-heading": "3.28.0",
    "@tiptap/extension-horizontal-rule": "3.28.0",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/extension-italic": "3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-list": "3.28.0",
    "@tiptap/extension-list-item": "3.28.0",
    "@tiptap/extension-list-keymap": "3.28.0",
    "@tiptap/extension-ordered-list": "3.28.0",
    "@tiptap/extension-paragraph": "3.28.0",
    "@tiptap/extension-placeholder": "3.28.0",
    "@tiptap/extension-strike": "3.28.0",
    "@tiptap/extension-table": "3.28.0",
    "@tiptap/extension-table-cell": "3.28.0",
    "@tiptap/extension-table-header": "3.28.0",
    "@tiptap/extension-table-row": "3.28.0",
    "@tiptap/extension-task-item": "3.28.0",
    "@tiptap/extension-task-list": "3.28.0",
    "@tiptap/extension-text": "3.28.0",
    "@tiptap/extension-text-style": "3.28.0",
    "@tiptap/extension-typography": "3.28.0",
    "@tiptap/extension-underline": "3.28.0",
    "@tiptap/extensions": "3.28.0",
    "@tiptap/markdown": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "file-type": "^22.0.1",
    "octane": "^0.1.22",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@tsrx/typescript-plugin": "^0.3.118",
    "@types/node": "^25.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@tiptap/core": "3.28.0",
    "@tiptap/pm": "3.28.0"
  }
}
